# =============================================================================
# chatPDF Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=chatPDF
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# =============================================================================
# OpenAI Configuration
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id  # Optional

# =============================================================================
# Ollama Configuration (Local LLM)
# =============================================================================
# Ollama base URL (use http://ollama:11434 in Docker, http://localhost:11434 locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# =============================================================================
# HuggingFace Configuration
# =============================================================================
# Get your token from: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_huggingface_token_here  # Optional, for gated models
HF_CACHE_DIR=./data/models/huggingface

# =============================================================================
# MegaLLM Configuration (Recommended - Unified API for Multiple LLMs)
# =============================================================================
# Get your API key from: https://megallm.io/dashboard
# MegaLLM provides access to GPT, Claude, Gemini, and other models via single API
MEGALLM_API_KEY=mega_your_api_key_here

# Available MegaLLM Models (configured in the app):
# - gpt-5-mini: Latest GPT mini model
# - claude-haiku-4-5: Claude Haiku 4.5
# - gemini-2-5-flash: Gemini 2.5 Flash
# Verify exact model IDs at: https://megallm.io/dashboard/models

# =============================================================================
# File Storage Configuration
# =============================================================================
UPLOAD_FOLDER=./data/uploads
MAX_FILE_SIZE=50  # Maximum file size in MB
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# =============================================================================
# Vector Store Configuration
# =============================================================================
VECTOR_STORE_TYPE=faiss  # Options: faiss, chromadb
VECTOR_STORE_PATH=./data/vector_stores
EMBEDDING_MODEL=text-embedding-ada-002  # OpenAI embedding model
EMBEDDING_DIMENSION=1536

# =============================================================================
# RAG Pipeline Configuration
# =============================================================================
# Text Chunking
CHUNK_SIZE=1000  # Characters per chunk
CHUNK_OVERLAP=200  # Overlap between chunks

# Retrieval
TOP_K_RETRIEVAL=10  # Number of chunks to retrieve
USE_RERANKING=True  # Enable cross-encoder re-ranking
USE_COMPRESSION=False  # Enable contextual compression

# Hybrid Search
SEMANTIC_SEARCH_WEIGHT=0.7  # Weight for semantic search (0-1)
KEYWORD_SEARCH_WEIGHT=0.3  # Weight for keyword search (0-1)

# =============================================================================
# LLM Default Configuration
# =============================================================================
# Default model for generation
DEFAULT_MODEL=gpt-3.5-turbo  # Options: gpt-4, gpt-3.5-turbo, llama3, mistral, etc.
DEFAULT_TEMPERATURE=0.7  # 0.0 = deterministic, 1.0 = creative
DEFAULT_MAX_TOKENS=500  # Maximum tokens in response
DEFAULT_TOP_P=0.9
DEFAULT_FREQUENCY_PENALTY=0.0
DEFAULT_PRESENCE_PENALTY=0.0

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=sqlite:///./data/chatpdf.db
# For PostgreSQL: postgresql://user:password@localhost:5432/chatpdf

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# Cache Configuration (Optional)
# =============================================================================
ENABLE_CACHE=True
CACHE_TYPE=memory  # Options: memory, redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600  # Time-to-live in seconds (1 hour)

# =============================================================================
# Security & Rate Limiting (Optional)
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days
RATE_LIMIT=100  # Requests per minute

# =============================================================================
# CORS Configuration (Optional)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Model-Specific Configuration
# =============================================================================
# Ollama Models to Download
OLLAMA_MODELS=llama3:8b,mistral:7b,codellama:7b

# Sentence Transformers Models
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# =============================================================================
# Monitoring & Analytics (Optional)
# =============================================================================
ENABLE_ANALYTICS=True
TRACK_TOKEN_USAGE=True
TRACK_COSTS=True

# =============================================================================
# Development Settings
# =============================================================================
# Set to True to use mock services (for testing without API keys)
USE_MOCK_SERVICES=False
